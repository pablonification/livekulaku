!.agents/skills/**
.claude/
skills-lock.json

# python
__pycache__/
*.pyc
.pytest_cache/
.venv/
venv/

# node
node_modules/
backend/node_modules/

# env / secrets - use .env.example as template
.env
*.pem
*.key

