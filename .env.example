# ---- Liveku Laku runtime config (all optional except MODE) ----

# mock = deterministic replay of data/demo_comments.jsonl (judge-safe, offline)
# shopee = Shopee Open Platform polling (requires SHOPEE_* creds)
# tiktok = tiktok-live-connector websocket (requires TRY_TIKTOK=1)
MODE=mock

# Host ports used by Docker Compose. Override these when 8000 or 3000 is busy.
BACKEND_PORT=8000
FRONTEND_PORT=3000

# Aggregation window in seconds (card generated once per window)
WINDOW_SECONDS=10
# Speed multiplier: divides window and replay delays (use 4 for video recording)
DEMO_SPEED=1

# ---- Tier 2 coach: Meta Muse Spark (contributor tier) ----
# Get key at https://dev.meta.ai ; if absent or MODE=mock -> deterministic scripted cards
META_API_KEY=
META_BASE_URL=https://api.meta.ai/v1
META_MODEL=muse-spark-1.2-contributor
COACH_PROVIDER=auto   # auto | api | mock

# ---- Tier 1 classifier ----
# keyword = built-in Indonesian rule baseline (always available)
# local = load fine-tuned IndoBERT from model/checkpoints (if present)
CLASSIFIER_MODE=keyword

# ---- Optional live adapters (never enabled by default) ----
TRY_TIKTOK=0
SHOPEE_PARTNER_ID=
SHOPEE_PARTNER_KEY=
SHOPEE_SHOP_ID=
SHOPEE_ACCESS_TOKEN=
SHOPEE_REFRESH_TOKEN=
SHOPEE_SESSION_ID=
